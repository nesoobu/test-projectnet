# Токен бота от @BotFather (НЕ коммитить!)
BOT_TOKEN=
# Публичный адрес мини-аппа (https), откуда бот открывает Леру
WEBAPP_URL=https://app.lerarubot.ru
# База
DB_PATH=data/lera.db
UPLOAD_DIR=data/uploads
# Админы через запятую
ADMIN_IDS=8171156371
# Цена Premium в Telegram Stars (30 дней)
PREMIUM_STARS=99
# Только для локальной разработки: работать без Telegram под этим tg_id
DEV_USER_ID=
# Юзернейм бота без @ (для реферальных ссылок)
BOT_USERNAME=lerarubot
# ИИ-Лера (чат-помощник). Ключ: https://platform.claude.com → API Keys. Пусто = функция выключена
ANTHROPIC_API_KEY=
LERA_AI_MODEL=claude-opus-5-5
AI_DAILY_FREE=15
AI_DAILY_PREMIUM=60
# Про-матчи (вкладка «Про-сцена» в турнирах). PandaScore: бесплатный токен на https://pandascore.co → лого команд и live-счёт.
# Без токена данные берутся с Liquipedia (раз в ~15 минут на игру).
PANDASCORE_TOKEN=
LIQUIPEDIA=1
