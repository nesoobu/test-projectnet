BOT_TOKEN=123456:ABC...
# ID владельцев через запятую (полный доступ к /admin)
ADMIN_IDS=111111111
DB_PATH=data/bot.db

# --- необязательно ---
# Redis для FSM: pip install redis
# REDIS_URL=redis://localhost:6379/0
# Webhook вместо polling (бот слушает WEBAPP_HOST:WEBAPP_PORT, перед ним — nginx с HTTPS)
# WEBHOOK_URL=https://bot.example.com
# WEBHOOK_PATH=/tg
# WEBHOOK_SECRET=random-string
# WEBAPP_PORT=8080

# --- автовыдача через Fragment (delivery_mode = fragment), pip install fragment-api-py ---
# 24 слова отдельного кошелька магазина
# FRAGMENT_SEED=word1 word2 ... word24
# Cookies fragment.com после входа и подключения кошелька
# FRAGMENT_COOKIES=stel_ssid=...; stel_dt=...; stel_token=...; stel_ton_token=...
# Ключ с tonconsole.com (tonapi) или toncenter.com
# FRAGMENT_API_KEY=...
# FRAGMENT_API_PROVIDER=tonapi
# Tonkeeper W5 = V5R1, старые кошельки = V4R2
# FRAGMENT_WALLET_VERSION=V5R1
