BOT_TOKEN=123456:ABC...
# ID владельцев через запятую (полный доступ к /admin)
ADMIN_IDS=111111111
DB_PATH=data/bot.db

# --- необязательно ---
# Redis для FSM: pip install redis
# REDIS_URL=redis://localhost:6379/0
# Webhook вместо polling (бот слушает WEBAPP_HOST:WEBAPP_PORT, перед ним — nginx с HTTPS)
# WEBHOOK_URL=https://bot.example.com
# WEBHOOK_PATH=/tg
# WEBHOOK_SECRET=random-string
# WEBAPP_PORT=8080
